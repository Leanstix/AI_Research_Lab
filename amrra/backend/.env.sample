# ===== App =====
APP_ENV=dev
API_TITLE=AMRRA API
API_ROOT_PATH=

# ===== Database (SQLite) =====
# Creates ./data/amrra.db (the folder will be created if missing)
DATABASE_URL=sqlite:///./data/amrra.db

# ===== Celery/Redis (local) =====
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ===== AI integrations (same as your current setup) =====
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
TEI_EMBED_URL=http://localhost:8080/embed
RERANKER_URL=http://localhost:8081/rerank
OLLAMA_URL=http://localhost:11434
RUST_SIM_BASE=http://localhost:5000

# ===== Hedera (via local Node microservice) =====
HCS_LOGGER_URL=http://127.0.0.1:3001/hcs/log
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=302e...
HEDERA_TOPIC_ID=0.0.yyyyy
